{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*", "../*"],
      "@/lib/*": ["./lib/*", "../lib/*"],
      "@/common/*": ["./common/*", "../common/*"],
      "@/job-seeker/*": ["../job-seeker/*"],
      "@/recruiter/*": ["./*", "../recruiter/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../lib/**/*.ts",
    "../common/**/*.ts",
    "../common/**/*.tsx",
    "../job-seeker/**/*.ts",
    "../job-seeker/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
