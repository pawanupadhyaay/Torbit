datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  role         String          // "JOB_SEEKER", "RECRUITER", "ADMIN"
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  seekerProfile  SeekerProfile?
  companyProfile CompanyProfile?
  adminLogs      AdminAuditLog[]
}

model SeekerProfile {
  id                 String        @id @default(cuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  phone              String
  location           String?
  dob                String?
  qualification      String?
  experience         String?
  currentSalary      Float?
  expectedSalary     Float?
  noticePeriod       String?
  portfolioUrl       String?
  resumeUrl          String?
  resumeOriginalName String?
  skills             String?
  avatarUrl          String?
  profileCompleted   Int           @default(72)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  applications Application[]
  jobAlerts    JobAlert[]
}

model CompanyProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  industry        String    @default("Real Estate")
  workEmail       String
  phone           String
  gstNumber       String
  hqLocation      String
  logoUrl         String?
  docUrl          String?
  status          String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "BLOCKED"
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  jobs Job[]
}

model Job {
  id               String         @id @default(cuid())
  companyId        String
  company          CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title            String
  department       String
  customDepartment String?
  jobType          String
  workMode         String
  location         String
  expMin           Int            @default(0)
  expMax           Int            @default(5)
  salaryMin        Float?
  salaryMax        Float?
  hideSalary       Boolean        @default(false)
  description      String
  skills           String
  deadline         DateTime?
  openings         Int            @default(1)
  isFeatured       Boolean        @default(false)
  status           String         @default("ACTIVE")
  customQuestions  Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  applications Application[]
}

model Application {
  id                 String        @id @default(cuid())
  jobId              String
  job                Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seekerId           String
  seeker             SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  resumeUrl          String
  resumeOriginalName String
  currentSalary      Float?
  expectedSalary     Float?
  noticePeriod       String
  coverLetter        String?
  portfolioUrl       String?
  customAnswers      Json?
  status             String        @default("APPLIED")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Category {
  id         String   @id @default(cuid())
  name       String   @unique
  slug       String   @unique
  iconColor  String   @default("#b2c359")
  jobCount   Int      @default(0)
  isPopular  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  action     String
  reason     String?
  createdAt  DateTime @default(now())
}

model JobAlert {
  id          String        @id @default(cuid())
  seekerId    String
  seeker      SeekerProfile @relation(fields: [seekerId], references: [id], onDelete: Cascade)
  title       String
  location    String
  category    String
  minSalary   String?
  frequency   String        @default("Daily Instant Alert")
  emailActive Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}